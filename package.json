{
  "name": "apple-docs",
  "version": "0.1.0",
  "description": "Apple Developer Documentation CLI",
  "type": "module",
  "bin": {
    "apple-docs": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "build": "bun build src/cli.ts --outfile=dist/apple-docs --target=bun --minify && chmod +x dist/apple-docs"
  },
  "dependencies": {
    "argc": "github:ethan-huo/argc",
    "cheerio": "^1.1.0"
  },
  "devDependencies": {
    "valibot": "^1.2.0",
    "@valibot/to-json-schema": "^1.5.0",
    "@types/bun": "^1.3.8",
    "typescript": "^5.7.2"
  }
}
